# Public port for the StudyOS web application
PORT=8000

# Recommended for production: generate with `openssl rand -hex 32`.
# If left blank, StudyOS generates and securely persists a random key in its data volume.
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# AI provider: openai (also supports compatible endpoints), deepseek, or offline.
AI_PROVIDER=openai

# Optional DeepSeek API credentials (used only when AI_PROVIDER=deepseek).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: enables synthesized AI tutoring and AI-generated schedules.
# Without a key, cited retrieval and the offline learning-science planner still work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Comma-separated development origins. The production frontend is served same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25

# Set false after creating your account to disable public registration.
ALLOW_SIGNUP=true
